# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不会提交到仓库。

# 会话密钥：用 python -c "import secrets;print(secrets.token_hex(32))" 生成
SECRET_KEY=

# 首次启动要自动创建的管理员（生产环境推荐设置；留空则仅开发模式创建 admin/admin123）
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# SMTP 邮件配置（用于发送注册/重置验证码；不配置则验证码打印到控制台，仅限开发）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=1
MAIL_USERNAME=
MAIL_PASSWORD=

# 运行参数
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
